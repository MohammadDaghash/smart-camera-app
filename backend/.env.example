# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must never be committed.

# Admin login credentials. If unset, the app falls back to admin/admin
# (development only) and logs a warning at startup.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Secret used to sign session cookies. Generate a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random key is generated at startup and all logins reset on restart.
SESSION_SECRET=

# Optional: session lifetime in seconds (default 86400 = 24 hours).
# SESSION_MAX_AGE_SECONDS=86400

# Optional: send the session cookie only over HTTPS. Enable when behind TLS.
# SESSION_HTTPS_ONLY=false

# Optional: login rate limiting / lockout, per client IP.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_ATTEMPT_WINDOW_SECONDS=300
# LOGIN_LOCKOUT_SECONDS=300
