# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must never be committed.

# Admin login credentials. If unset, the app falls back to admin/admin
# (development only) and logs a warning at startup.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Secret used to sign session cookies. Generate a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random key is generated at startup and all logins reset on restart.
SESSION_SECRET=

# Optional: session lifetime in seconds (default 86400 = 24 hours).
# SESSION_MAX_AGE_SECONDS=86400

# Optional: send the session cookie only over HTTPS. Enable when behind TLS.
# SESSION_HTTPS_ONLY=false

# Optional: login rate limiting / lockout, per client IP.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_ATTEMPT_WINDOW_SECONDS=300
# LOGIN_LOCKOUT_SECONDS=300

# Optional: run face analysis every N frames. Keep 1 for the most accurate
# overlays. Increase to reduce CPU usage while testing performance.
# FACE_ANALYSIS_INTERVAL_FRAMES=1

# Optional: known-face match threshold. Lower values recognize known people more
# easily. Higher values reduce false matches. Valid range: 0.0 to 1.0.
# FACE_MATCH_THRESHOLD=0.45

# Optional: smooth recognition labels across nearby face boxes and recent frames.
# This helps reduce one-frame flicker between a known name and Anonymous.
# FACE_LABEL_SMOOTHING_ENABLED=true
# FACE_LABEL_SMOOTHING_HISTORY_SIZE=5
# FACE_LABEL_SMOOTHING_MIN_VOTES=2
# FACE_TRACK_IOU_THRESHOLD=0.2
# FACE_TRACK_TTL_FRAMES=5

# Optional: basic frame-to-frame motion detection.
# MOTION_DETECTION_ENABLED=true
# MOTION_MIN_AREA=500
# MOTION_SCORE_THRESHOLD=0.02

# Optional: event cooldowns to avoid repeated motion/face event spam.
# EVENT_MOTION_COOLDOWN_SECONDS=10
# EVENT_FACE_COOLDOWN_SECONDS=20

# Optional: local SQLite event cleanup.
# EVENT_MAX_EVENTS=1000
# EVENT_RETENTION_DAYS=30

# Optional: local JPEG snapshots for saved motion/face events.
# EVENT_SNAPSHOTS_ENABLED=true
# EVENT_SNAPSHOT_MAX_WIDTH=640
# EVENT_SNAPSHOT_JPEG_QUALITY=85

# Optional: local alert rules. Browser notifications are local to the dashboard.
# ALERTS_ENABLED=true
# ALERT_ANONYMOUS_MOTION_WINDOW_SECONDS=30
# ALERT_COOLDOWN_SECONDS=60

# Optional: activity review grouping. Events closer than this gap are shown as
# one review item on /review.
# REVIEW_EVENT_GAP_SECONDS=90
# REVIEW_SOURCE_EVENT_LIMIT=200
