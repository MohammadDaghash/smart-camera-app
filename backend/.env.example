# Email notification settings for the Smart Camera App.
#
# Copy this file to backend/.env and fill in real values, or export these as
# environment variables before starting the server. The .env file is gitignored
# so credentials are never committed.
#
# When SMTP_HOST / NOTIFY_EMAIL_FROM / NOTIFY_EMAIL_TO are empty the email
# notification feature is disabled (safe no-op).

# Person to notify about when seen on the live feed (matches the known-face name).
NOTIFY_PERSON_NAME=Omar

# Minimum seconds between emails for the same person (avoids spamming per frame).
NOTIFY_COOLDOWN_SECONDS=300

# SMTP server settings. Example below is for Gmail using an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

# From / To addresses. NOTIFY_EMAIL_TO may be a comma-separated list.
NOTIFY_EMAIL_FROM=your-account@gmail.com
NOTIFY_EMAIL_TO=alerts@example.com
# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must never be committed.

# Admin login credentials. If unset, the app falls back to admin/admin
# (development only) and logs a warning at startup.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Secret used to sign session cookies. Generate a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random key is generated at startup and all logins reset on restart.
SESSION_SECRET=

# Optional: session lifetime in seconds (default 86400 = 24 hours).
# SESSION_MAX_AGE_SECONDS=86400

# Optional: send the session cookie only over HTTPS. Enable when behind TLS.
# SESSION_HTTPS_ONLY=false

# Optional: login rate limiting / lockout, per client IP.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_ATTEMPT_WINDOW_SECONDS=300
# LOGIN_LOCKOUT_SECONDS=300
